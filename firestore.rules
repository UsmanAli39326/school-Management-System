rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if user is a SUPER_ADMIN
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == 'SUPER_ADMIN';
    }

    // Function to check if user belongs to the same school as the document
    function isSameSchool(resourceData) {
      return request.auth != null && resourceData != null && request.auth.token.schoolId == resourceData.schoolId;
    }

    // Function to check if user is at least a SCHOOL_ADMIN for the given school
    function isSchoolAdmin(resourceData) {
      return isSameSchool(resourceData) && request.auth.token.role == 'SCHOOL_ADMIN';
    }

    // Function to check if user has Admin or Accountant role
    function isFinanceUser(resourceData) {
      return isSameSchool(resourceData) && (request.auth.token.role == 'SCHOOL_ADMIN' || request.auth.token.role == 'ACCOUNTANT');
    }

    // Global rule: Super Admins can read/write everything
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Schools collection
    match /schools/{schoolId} {
      // Anyone logged in can read a school if they belong to it
      allow read: if request.auth != null && request.auth.token.schoolId == schoolId;
      // Only SCHOOL_ADMIN of that school can update it
      allow update: if request.auth != null && request.auth.token.schoolId == schoolId && request.auth.token.role == 'SCHOOL_ADMIN';
      allow create, delete: if isSuperAdmin();
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      // Users in the same school can read other users in that school
      allow read: if isSameSchool(resource.data);
      // School Admins can update/delete users for their school
      allow update, delete: if isSchoolAdmin(resource.data);
      // School Admins can create users for their school
      allow create: if isSchoolAdmin(request.resource.data);
      // Self-registration profile creation during setup-account
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role in ['SCHOOL_ADMIN', 'ACCOUNTANT', 'RECEPTIONIST', 'TEACHER', 'PENDING']
        && request.resource.data.schoolId is string;
    }

    // Activity Logs
    match /activity_logs/{logId} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSameSchool(request.resource.data) || (request.auth != null && request.auth.uid == request.resource.data.userId);
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isSameSchool(resource.data);
      allow create: if isFinanceUser(request.resource.data);
      allow update, delete: if isFinanceUser(resource.data);
    }

    // Students
    match /students/{studentId} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSameSchool(request.resource.data) && (request.auth.token.role == 'SCHOOL_ADMIN' || request.auth.token.role == 'RECEPTIONIST');
      allow update, delete: if isSameSchool(resource.data) && (request.auth.token.role == 'SCHOOL_ADMIN' || request.auth.token.role == 'RECEPTIONIST');
    }

    // Fee Structures, Payments, Student Ledgers, Accounting (Expenses)
    match /fee_structures/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isFinanceUser(request.resource.data);
      allow update, delete: if isFinanceUser(resource.data);
    }
    match /payments/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isFinanceUser(request.resource.data);
      allow update, delete: if isFinanceUser(resource.data);
    }
    match /student_ledgers/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isFinanceUser(request.resource.data);
      allow update, delete: if isFinanceUser(resource.data);
    }
    match /expenses/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isFinanceUser(request.resource.data);
      allow update, delete: if isFinanceUser(resource.data);
    }

    // Staff & Staff Invitations
    match /staff/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSchoolAdmin(request.resource.data);
      allow update, delete: if isSchoolAdmin(resource.data);
    }
    match /staff_invitations/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSchoolAdmin(request.resource.data);
      allow update, delete: if isSchoolAdmin(resource.data);
    }

    // Grades
    match /grades/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSameSchool(request.resource.data) && (request.auth.token.role == 'SCHOOL_ADMIN' || request.auth.token.role == 'TEACHER');
      allow update, delete: if isSameSchool(resource.data) && (request.auth.token.role == 'SCHOOL_ADMIN' || request.auth.token.role == 'TEACHER');
    }

    // Schedules & Academic Configuration (Sessions, Classes, Sections, Subjects)
    match /schedules/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSchoolAdmin(request.resource.data);
      allow update, delete: if isSchoolAdmin(resource.data);
    }
    match /academic_sessions/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSchoolAdmin(request.resource.data);
      allow update, delete: if isSchoolAdmin(resource.data);
    }
    match /classes/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSchoolAdmin(request.resource.data);
      allow update, delete: if isSchoolAdmin(resource.data);
    }
    match /sections/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSchoolAdmin(request.resource.data);
      allow update, delete: if isSchoolAdmin(resource.data);
    }
    match /subjects/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSchoolAdmin(request.resource.data);
      allow update, delete: if isSchoolAdmin(resource.data);
    }

    // Student & Staff Attendance
    match /student_attendance/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSameSchool(request.resource.data) && (request.auth.token.role == 'SCHOOL_ADMIN' || request.auth.token.role == 'TEACHER' || request.auth.token.role == 'RECEPTIONIST');
      allow update, delete: if isSameSchool(resource.data) && (request.auth.token.role == 'SCHOOL_ADMIN' || request.auth.token.role == 'TEACHER' || request.auth.token.role == 'RECEPTIONIST');
    }
    match /staff_attendance/{id} {
      allow read: if isSameSchool(resource.data);
      allow create: if isSameSchool(request.resource.data) && (request.auth.token.role == 'SCHOOL_ADMIN' || request.auth.token.role == 'RECEPTIONIST');
      allow update, delete: if isSameSchool(resource.data) && (request.auth.token.role == 'SCHOOL_ADMIN' || request.auth.token.role == 'RECEPTIONIST');
    }

    // Strict fallback catch-all rule (read-only for same school, no unhandled collection writes)
    match /{collectionName}/{docId} {
      allow read: if isSameSchool(resource.data);
    }
  }
}
